# Dependencies
node_modules/
**/node_modules/

# Build output
app/dist/
dist/
build/
out/
*.exe

# Wrangler / Cloudflare local state (may contain local dev state; never commit)
.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*

# Local runtime config that could hold secrets (belt-and-braces; app config lives in userData, not here)
**/config.json
!app/**/config.js

# Logs / scratch
*.log
npm-debug.log*
/Errors

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# Env files
.env
.env.*

# Native Rust rewrite build artifacts
native/target/
native/third-party-licenses.html
# Third-party notices generated per OS by native/scripts/release-assets.sh. Never
# committed: a checked-in copy goes stale with every Cargo.lock change.
native/app/THIRD-PARTY-LICENSES.html
# The service binary staged for the Windows installer by release-assets.sh (task W4).
native/app/service-bin/
native/app/gen/schemas/

# Cisco's OpenH264 binary must reach users only as a separate download from
# Cisco (licence condition 1, plan 04 §5) — never commit a copy.
*openh264*.dll
*openh264*.so
*openh264*.so.*
*openh264*.dylib
*openh264*.bz2
