{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShareCtrlScreen",
  "identifier": "dev.netameta.sharectrl",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ShareCtrlScreen",
        "width": 1600,
        "height": 900,
        "minWidth": 720,
        "minHeight": 520,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yanivkalfa/shareCtrlScreen/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGNThEMzI1MzI5NkU3QjEKUldTeDU1WXlKZE5ZNzRxZWtiZTF0MXFkcDJxbTdNSnZXTFFoZis5Y3dQdCtIaXBGM1czMGxBYVIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Remote desktop sharing and control",
    "longDescription": "Share your screen with, or control, another computer over an end-to-end encrypted peer-to-peer connection.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "section": "net",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpipewire-0.3-0",
          "libxkbcommon0"
        ],
        "recommends": ["libva2", "libva-drm2", "xdg-desktop-portal"],
        "desktopTemplate": "linux/sharectrl.desktop"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "pipewire-libs", "libxkbcommon"],
        "recommends": ["libva", "xdg-desktop-portal"],
        "desktopTemplate": "linux/sharectrl.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
