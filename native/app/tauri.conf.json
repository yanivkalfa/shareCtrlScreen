{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShareCtrlScreen",
  "version": "2.0.0",
  "identifier": "dev.netameta.sharectrl",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ShareCtrlScreen",
        "width": 1600,
        "height": 900,
        "minWidth": 720,
        "minHeight": 520,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
