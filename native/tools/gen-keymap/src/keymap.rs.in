// The key data below is derived from Chromium's
// ui/events/keycodes/dom/dom_code_data.inc at commit @COMMIT@.
// This file is generated by native/tools/gen-keymap: do not edit it, change
// the tool or the input and run `cargo run -p gen-keymap` from native/.

//! Physical-key identity shared by every OS backend (plan 04 §6).
//!
//! The wire format carries DOM `KeyboardEvent.code` strings; each backend
//! needs its own native number for the same physical key. [`KeyId`] is the
//! pivot: a USB HID usage (keyboard/keypad page 0x07), which Chromium's table
//! ties to the DOM code, the Windows Set-1 scancode, the Linux evdev code and
//! the macOS `kVK_*` code of that key.
//!
//! * Windows: [`KeyId::to_set1`] / [`KeyId::from_set1`], the make code plus
//!   whether it carries the `E0` prefix (`KEYEVENTF_EXTENDEDKEY`).
//! * Linux: [`KeyId::to_evdev`] / [`KeyId::from_evdev`]; X11 keycodes are the
//!   evdev code plus 8.
//! * macOS: [`KeyId::to_mac`] / [`KeyId::from_mac`]; `kVK_ANSI_*` name key
//!   positions of the US layout, which is the layout-independence the
//!   protocol wants.
//!
//! A key an OS has no code for maps to `None` on that OS only. Keys the old
//! hand-written Set-1 table deliberately left out (Pause, media keys, Fn) are
//! not in the table at all and map to `None` everywhere. Every lookup is a
//! direct index or a binary search over a static array: no heap, no scans.
//!
//! ## References
//!
//! * Chromium `ui/events/keycodes/dom/dom_code_data.inc` (BSD-3-Clause), the
//!   source of every number here; its header documents the per-platform
//!   quirks (W1 `Lang5`/`F24`, M1 `Insert`/`Help`, L1/L2 Linux gaps).
//! * W3C UI Events KeyboardEvent `code` Values, <https://www.w3.org/TR/uievents-code/>.
//! * Linux `include/uapi/linux/input-event-codes.h` for the evdev numbers.
//! * Apple `HIToolbox/Events.h` for the `kVK_*` numbers.
//! * USB HID Usage Tables, Keyboard/Keypad Page (0x07).

/// A physical key, identified by its USB HID usage on the keyboard/keypad
/// page. The field is private so that every `KeyId` names a key of the table
/// and the lookups below cannot miss.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct KeyId(u16);

/// A Windows Set-1 scancode: the make code and whether it is sent with the
/// `E0` prefix (`KEYEVENTF_EXTENDEDKEY` for `SendInput`).
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct Set1 {
    pub code: u8,
    pub extended: bool,
}

/// One row of [`TABLE`]. Absent native codes use Chromium's markers
/// ([`NO_SET1`], [`NO_EVDEV`], [`NO_MAC`]); `set1` is the make code, with
/// [`EXTENDED`] or-ed in for `E0`-prefixed keys.
struct Key {
    usb: u16,
    dom: &'static str,
    set1: u16,
    evdev: u16,
    mac: u16,
}

const NO_SET1: u16 = 0;
const NO_EVDEV: u16 = 0;
// Zero is a real macOS code (`kVK_ANSI_A`), so "absent" cannot be zero there.
const NO_MAC: u16 = 0xffff;
const EXTENDED: u16 = 0xe000;

/// Every supported key, ordered by USB usage.
#[rustfmt::skip]
const TABLE: &[Key] = &[
@TABLE@];

// Inverse indices: `(native code, position in TABLE)`, sorted by native code
// so that a binary search finds the key. Generated together with `TABLE`.
@INDICES@
// Position in `TABLE` by USB usage (255 in the gaps no `KeyId` can reach): the
// O(1) forward path.
@BY_USB@
/// Binary-searches one of the `BY_*` indices.
fn find<K: Ord>(index: &[(K, u8)], native: K) -> Option<KeyId> {
    let at = index.binary_search_by(|(k, _)| k.cmp(&native)).ok()?;
    Some(KeyId(TABLE[usize::from(index[at].1)].usb))
}

/// The key a DOM `KeyboardEvent.code` string names, if it is supported.
pub fn from_dom(code: &str) -> Option<KeyId> {
    find(&BY_DOM, code)
}

/// The DOM `KeyboardEvent.code` string of a key.
pub fn dom_for(key: KeyId) -> &'static str {
    key.entry().dom
}

impl KeyId {
    /// The USB HID usage (keyboard/keypad page 0x07) of this key.
    pub fn usb(self) -> u16 {
        self.0
    }

    fn entry(self) -> &'static Key {
        // Safe by construction: a `KeyId` only comes out of `find`, which
        // takes the usage from `TABLE`, and `BY_USB` covers every such usage.
        &TABLE[usize::from(BY_USB[usize::from(self.0)])]
    }

    /// The Windows Set-1 scancode, or `None` if Windows has none for the key.
    pub fn to_set1(self) -> Option<Set1> {
        let raw = self.entry().set1;
        (raw != NO_SET1).then_some(Set1 {
            // The low byte is the make code; the generator rejects any other
            // prefix than E0 in the high byte.
            code: (raw & 0x00ff) as u8,
            extended: raw & 0xff00 == EXTENDED,
        })
    }

    /// The key a Windows Set-1 scancode names, if it is supported.
    pub fn from_set1(set1: Set1) -> Option<KeyId> {
        let prefix = if set1.extended { EXTENDED } else { 0 };
        find(&BY_SET1, u16::from(set1.code) | prefix)
    }

    /// The Linux evdev code (`KEY_*`), or `None` if Linux has none.
    pub fn to_evdev(self) -> Option<u16> {
        let raw = self.entry().evdev;
        (raw != NO_EVDEV).then_some(raw)
    }

    /// The key a Linux evdev code names, if it is supported.
    pub fn from_evdev(code: u16) -> Option<KeyId> {
        find(&BY_EVDEV, code)
    }

    /// The macOS virtual key code (`kVK_*`), or `None` if macOS has none.
    pub fn to_mac(self) -> Option<u16> {
        let raw = self.entry().mac;
        (raw != NO_MAC).then_some(raw)
    }

    /// The key a macOS virtual key code names, if it is supported.
    pub fn from_mac(code: u16) -> Option<KeyId> {
        find(&BY_MAC, code)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn key(dom: &str) -> KeyId {
        from_dom(dom).unwrap_or_else(|| panic!("{dom} is not in the table"))
    }

    #[test]
    fn key_a_on_every_os() {
        let a = key("KeyA");
        assert_eq!(a.usb(), 0x04);
        assert_eq!(
            a.to_set1(),
            Some(Set1 {
                code: 0x1e,
                extended: false
            })
        );
        assert_eq!(a.to_evdev(), Some(30));
        assert_eq!(a.to_mac(), Some(0x00));
    }

    #[test]
    fn numpad_enter_is_extended_set1_1c() {
        let enter = key("NumpadEnter");
        assert_eq!(
            enter.to_set1(),
            Some(Set1 {
                code: 0x1c,
                extended: true
            })
        );
        assert_eq!(enter.to_evdev(), Some(96));
        assert_eq!(enter.to_mac(), Some(0x4c));
        // The plain 0x1c scancode is the main Enter key, not the keypad's.
        assert_eq!(
            KeyId::from_set1(Set1 {
                code: 0x1c,
                extended: false
            }),
            Some(key("Enter"))
        );
    }

    #[test]
    fn a_missing_native_code_is_none_on_that_os_only() {
        // ScrollLock has no macOS key but exists on Windows and Linux.
        let scroll = key("ScrollLock");
        assert_eq!(scroll.to_mac(), None);
        assert!(scroll.to_set1().is_some() && scroll.to_evdev().is_some());
    }

    #[test]
    fn excluded_keys_are_unknown_everywhere() {
        for dom in ["Pause", "Fn", "MediaPlayPause", "AudioVolumeUp", "Power"] {
            assert_eq!(from_dom(dom), None, "{dom}");
        }
        assert_eq!(from_dom("Nonsense"), None);
    }

    #[test]
    fn every_key_round_trips_through_every_index() {
        for row in TABLE {
            let id = key(row.dom);
            assert_eq!(id.usb(), row.usb);
            assert_eq!(dom_for(id), row.dom);
            if let Some(set1) = id.to_set1() {
                assert_eq!(KeyId::from_set1(set1), Some(id), "{}", row.dom);
            }
            if let Some(evdev) = id.to_evdev() {
                assert_eq!(KeyId::from_evdev(evdev), Some(id), "{}", row.dom);
            }
            if let Some(mac) = id.to_mac() {
                assert_eq!(KeyId::from_mac(mac), Some(id), "{}", row.dom);
            }
        }
    }

    #[test]
    fn table_and_indices_are_ordered_for_binary_search() {
        assert!(TABLE.windows(2).all(|w| w[0].usb < w[1].usb));
        assert!(BY_DOM.windows(2).all(|w| w[0].0 < w[1].0));
        assert!(BY_SET1.windows(2).all(|w| w[0].0 < w[1].0));
        assert!(BY_EVDEV.windows(2).all(|w| w[0].0 < w[1].0));
        assert!(BY_MAC.windows(2).all(|w| w[0].0 < w[1].0));
        assert_eq!(BY_DOM.len(), TABLE.len());
    }
}
